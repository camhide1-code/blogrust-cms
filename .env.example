# ============================================================================
# 🦀 BlogRust Voorbeeld Omgevingsvariabelen (.env.example)
# Kopieer dit bestand naar .env (cp .env.example .env) of genereer het via /instellingen
# ============================================================================

# Server & Database Configuratie
BLOGRUST_PORT=3000
BLOGRUST_DOMAIN=localhost
BLOGRUST_DB_PAD=data/blogrust.db
RUST_LOG=info

# Optioneel: Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Plug-in & Custom Variabelen (beschikbaar in .rhai via env("SLEUTEL"))
REACTIES_INGESCHAKELD=true
